# Copy this to .streamlit/secrets.toml when deploying to Streamlit Community Cloud,
# or paste the same keys into the app's Secrets manager in the Streamlit dashboard.
#
# Locally you do NOT need this file: the app reads .env instead.

GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-3.1-flash-lite"
